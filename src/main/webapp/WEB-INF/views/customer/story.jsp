<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<head>
    <title>Câu Chuyện Thương Hiệu - UTECoffe Artisanal Roastery</title>
</head>
<body class="bg-obsidian">

    <!-- Editorial Story Hero -->
    <section class="py-5 bg-espresso border-bottom border-gold text-center position-relative overflow-hidden">
        <div class="container py-lg-4 position-relative" style="z-index: 2;">
            <span class="badge bg-gold-subtle text-gold px-3 py-1 rounded-pill small font-accent mb-3 text-uppercase" style="letter-spacing: 0.15em;">
                <i class="fa-solid fa-gem me-1"></i> KHỞI NGUỒN TỪ ĐAM MÊ NGUYÊN BẢN
            </span>
            <h1 class="font-serif display-3 fw-bold text-gold-gradient mb-3" data-i18n="nav.story">
                Hành Trình Di Sản Cà Phê
            </h1>
            <p class="lead text-secondary mx-auto" style="max-width: 760px; font-weight: 300; line-height: 1.8;">
                Tại UTECoffe, chúng tôi tin rằng mỗi tách cà phê là một tác phẩm nghệ thuật sống động, kết tinh từ thổ nhưỡng bazan huyền thoại Cầu Đất 1.600m và sự tỉ mỉ của những nghệ nhân rang mộc thủ công.
            </p>
        </div>
    </section>

    <!-- Key Craft Metrics (Animated Counters) -->
    <section class="py-4 bg-dark-roast border-bottom border-gold">
        <div class="container">
            <div class="row g-4 text-center">
                <div class="col-md-3 col-6">
                    <div class="hero-stat-card border-0">
                        <h2 class="font-serif text-gold fw-bold mb-1">
                            <span class="counter-metric" data-counter="1600" data-counter-format="comma" data-counter-suffix="m">1.600m</span>
                        </h2>
                        <span class="text-secondary small text-uppercase font-accent fw-semibold">Độ Cao Thổ Nhưỡng</span>
                    </div>
                </div>
                <div class="col-md-3 col-6">
                    <div class="hero-stat-card border-0">
                        <h2 class="font-serif text-gold fw-bold mb-1">
                            <span class="counter-metric" data-counter="85" data-counter-suffix="+">85+</span>
                        </h2>
                        <span class="text-secondary small text-uppercase font-accent fw-semibold">Điểm Cupping Quốc Tế</span>
                    </div>
                </div>
                <div class="col-md-3 col-6">
                    <div class="hero-stat-card border-0">
                        <h2 class="font-serif text-gold fw-bold mb-1">
                            <span class="counter-metric" data-counter="100" data-counter-suffix="%">100%</span>
                        </h2>
                        <span class="text-secondary small text-uppercase font-accent fw-semibold">Trái Chín Hái Thủ Công</span>
                    </div>
                </div>
                <div class="col-md-3 col-6">
                    <div class="hero-stat-card border-0">
                        <h2 class="font-serif text-gold fw-bold mb-1">
                            <span class="counter-metric" data-counter="48" data-counter-suffix="h">48h</span>
                        </h2>
                        <span class="text-secondary small text-uppercase font-accent fw-semibold">Lên Men Chậm Tự Nhiên</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Chapter 1: The Mountain Terroir -->
    <section class="py-5">
        <div class="container py-4">
            <div class="row align-items-center g-5">
                <div class="col-lg-6">
                    <div class="position-relative">
                        <img src="https://images.unsplash.com/photo-1501339847302-ac426a4a7cbb?auto=format&fit=crop&w=800&q=80" 
                             alt="Cầu Đất Terroir" class="img-fluid rounded-4 shadow-lg border border-gold">
                        <span class="badge bg-gold text-obsidian fw-bold font-monospace position-absolute top-0 start-0 m-3 px-3 py-2 rounded-pill">
                            TERROIR 1.600M
                        </span>
                    </div>
                </div>
                <div class="col-lg-6">
                    <span class="text-gold font-accent fw-bold text-uppercase small" style="letter-spacing: 0.15em;">Chương I • Thổ Nhưỡng</span>
                    <h2 class="font-serif fw-bold text-gold-gradient mb-3">Độ Cao 1.600m &amp; Sương Mù Cao Nguyên</h2>
                    <p class="text-secondary leading-relaxed">
                        Cầu Đất - Đà Lạt được mệnh danh là thiên đường của cà phê Arabica hảo hạng tại Việt Nam. Độ cao 1.600m so với mực nước biển cùng biên độ nhiệt ngày đêm lớn giúp hạt cà phê phát triển chậm rãi, cô đọng lượng đường tự nhiên và axit hữu cơ thanh nhã.
                    </p>
                    <p class="text-secondary leading-relaxed">
                        Chúng tôi trực tiếp liên kết cùng các nông hộ tâm huyết, chỉ thu hoạch những trái chín đỏ 100% bằng tay, đảm bảo độ đồng đều và chất lượng cupping đạt chuẩn Specialty Coffee Association (SCA).
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- Chapter 2: The Roastery Craft -->
    <section class="py-5 bg-dark-roast border-top border-gold">
        <div class="container py-4">
            <div class="row align-items-center g-5 flex-lg-row-reverse">
                <div class="col-lg-6">
                    <div class="position-relative">
                        <img src="https://images.unsplash.com/photo-1518832553480-cd0e625ed3e6?auto=format&fit=crop&w=800&q=80" 
                             alt="Artisanal Roasting" class="img-fluid rounded-4 shadow-lg border border-gold">
                        <span class="badge bg-gold text-obsidian fw-bold font-monospace position-absolute top-0 end-0 m-3 px-3 py-2 rounded-pill">
                            GIESEN ROASTER
                        </span>
                    </div>
                </div>
                <div class="col-lg-6">
                    <span class="text-gold font-accent fw-bold text-uppercase small" style="letter-spacing: 0.15em;">Chương II • Kỹ Nghệ Rang</span>
                    <h2 class="font-serif fw-bold text-gold-gradient mb-3">Nghệ Thuật Đánh Thức Dải Hương Bản Độc</h2>
                    <p class="text-secondary leading-relaxed">
                        Rang cà phê không đơn thuần là xử lý nhiệt; đó là cuộc đối thoại giữa nghệ nhân và hạt mầm tự nhiên. Bằng công nghệ trống rang hiện đại kiểm soát luồng khí và nhiệt độ chuẩn xác từng giây, chúng tôi phát triển tối đa dải hương hoa nhài, cam bergamot, mật ong rừng và socola đen đặc trưng.
                    </p>
                    <p class="text-secondary leading-relaxed">
                        Mỗi mẻ rang mộc hoàn toàn không tẩm ướp phụ gia hay hương liệu nhân tạo, tôn vinh sự tinh khiết tuyệt đối của nông sản quê hương.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- Chapter 3: Artisanal Extraction Techniques -->
    <section class="py-5 border-top border-gold">
        <div class="container py-4">
            <div class="row align-items-center g-5">
                <div class="col-lg-6">
                    <div class="position-relative">
                        <img src="https://images.unsplash.com/photo-1514432324607-a09d9b4aefdd?auto=format&fit=crop&w=800&q=80" 
                             alt="Slow Bar Extraction" class="img-fluid rounded-4 shadow-lg border border-gold">
                        <span class="badge bg-gold text-obsidian fw-bold font-monospace position-absolute top-0 start-0 m-3 px-3 py-2 rounded-pill">
                            SLOW BAR V60 &amp; ESPRESSO
                        </span>
                    </div>
                </div>
                <div class="col-lg-6">
                    <span class="text-gold font-accent fw-bold text-uppercase small" style="letter-spacing: 0.15em;">Chương III • Nghệ Thuật Chiết Xuất</span>
                    <h2 class="font-serif fw-bold text-gold-gradient mb-3">Tỷ Lệ Vàng Trong Từng Giọt Cà Phê</h2>
                    <p class="text-secondary leading-relaxed">
                        Từ dòng máy Espresso La Marzocco thủ công đến các bình chiết xuất V60 Hario gốm sứ Nhật Bản, mỗi giọt cà phê chiết xuất tại UTECoffe đều tuân thủ biểu đồ TDS chuẩn mực quốc tế.
                    </p>
                    <p class="text-secondary leading-relaxed">
                        Kỹ thuật ủ lạnh Specialty Cold Brew kéo dài liên tục 18 đến 24 giờ trong nhiệt độ 4°C giúp chiết tách tối đa vị ngọt hậu và loại bỏ hoàn toàn vị đắng gắt, đem lại trải nghiệm thanh tao như dòng vang hảo hạng.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- Chapter 4: Flavor Wheel & Sustainability -->
    <section class="py-5 bg-dark-roast border-top border-gold">
        <div class="container py-4 text-center">
            <span class="badge bg-gold-subtle text-gold px-3 py-1 rounded-pill small font-accent mb-2 text-uppercase" style="letter-spacing: 0.15em;">
                PHỔ HƯƠNG VỊ ĐẶC SẢN
            </span>
            <h2 class="font-serif display-5 fw-bold text-gold-gradient mb-4">
                Dải Hương Độc Bản Của UTECoffe
            </h2>
            <p class="text-secondary mx-auto mb-5" style="max-width: 650px;">
                Mỗi mẻ cà phê được đánh giá cupping theo tiêu chuẩn khắt khe với 4 nhóm hương vị đặc trưng:
            </p>

            <div class="row g-4">
                <div class="col-lg-3 col-6">
                    <div class="card-luxury p-4 h-100">
                        <i class="fa-solid fa-lemon text-gold display-5 mb-3"></i>
                        <h5 class="font-serif fw-bold text-light mb-2">Cam Quýt &amp; Bergamot</h5>
                        <p class="text-secondary small mb-0">Axit citric tự nhiên sáng ngời, gợi nhớ hương cam sành và vỏ chanh vàng thanh nhã.</p>
                    </div>
                </div>
                <div class="col-lg-3 col-6">
                    <div class="card-luxury p-4 h-100">
                        <i class="fa-solid fa-spa text-gold display-5 mb-3"></i>
                        <h5 class="font-serif fw-bold text-light mb-2">Hoa Nhài &amp; Bạch Cúc</h5>
                        <p class="text-secondary small mb-0">Hương hoa trắng thoang thoảng nở rộ khi pha Pour-over nóng bốc khói nhẹ nhàng.</p>
                    </div>
                </div>
                <div class="col-lg-3 col-6">
                    <div class="card-luxury p-4 h-100">
                        <i class="fa-solid fa-jar text-gold display-5 mb-3"></i>
                        <h5 class="font-serif fw-bold text-light mb-2">Mật Ong Hoa Cà Phê</h5>
                        <p class="text-secondary small mb-0">Hậu vị ngọt sâu kéo dài nơi cuống họng, êm dịu và tròn trịa sau từng ngụm thưởng thức.</p>
                    </div>
                </div>
                <div class="col-lg-3 col-6">
                    <div class="card-luxury p-4 h-100">
                        <i class="fa-solid fa-cookie text-gold display-5 mb-3"></i>
                        <h5 class="font-serif fw-bold text-light mb-2">Chocolate Đen &amp; Hạt Nướng</h5>
                        <p class="text-secondary small mb-0">Vị đắng êm dịu của cacao nguyên chất hòa quyện nốt hạnh nhân nướng thơm bùi.</p>
                    </div>
                </div>
            </div>

            <!-- Call to Action -->
            <div class="mt-5 pt-4">
                <div class="d-flex justify-content-center gap-3 flex-wrap">
                    <a href="${pageContext.request.contextPath}/menu" class="btn btn-gold px-4 py-3 rounded-pill font-accent fw-bold">
                        <i class="fa-solid fa-mug-hot me-2"></i> Khám Phá Toàn Bộ Thực Đơn
                    </a>
                    <a href="${pageContext.request.contextPath}/reservation" class="btn btn-outline-gold px-4 py-3 rounded-pill font-accent">
                        <i class="fa-solid fa-calendar-check me-2"></i> Đặt Bàn Thưởng Thức Tại Quán
                    </a>
                </div>
            </div>
        </div>
    </section>
</body>
